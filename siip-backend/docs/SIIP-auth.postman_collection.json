          "raw": "{\n  \"nombre\": \"Captura de prueba\",\n  \"correo\": \"{{capturaCorreo}}\",\n  \"password\": \"{{capturaPassword}}\",\n  \"rol\": \"captura\",\n  \"dependencia_id\": \"{{dependenciaId}}\"\n}",
